# AI ასისტენტის მოდელი — ნებისმიერი OpenAI-თავსებადი API.
#
# უფასო და ლოკალური (ნაგულისხმევი): დააინსტალირეთ Ollama და გაუშვით `npm run setup:ai`.
# ამ ფაილის შევსება საჭირო არ არის — ასისტენტი ავტომატურად იპოვის ლოკალურ მოდელს.
#
# ან გამოიყენეთ ღრუბლოვანი API (ქართულს უკეთ ფლობს). მაგალითები (აირჩიეთ ერთი):

# Google Gemini (უფასო ტარიფი, ლიმიტებით) — https://aistudio.google.com/apikey
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=

LLM_MODEL=gemini-3.8-flash
LLM2_MODEL=openai/gpt-oss-20b
# Groq:        LLM_BASE_URL=https://api.groq.com/openai/v1           LLM_MODEL=llama-3.1-8b-instant
# OpenRouter:  LLM_BASE_URL=https://openrouter.ai/api/v1             LLM_MODEL=<მოდელი>:free
# Ollama:      LLM_BASE_URL=http://localhost:11434/v1  (გასაღები არ სჭირდება)   LLM_MODEL=qwen2.5:14b
# Azure OpenAI:
#   LLM_BASE_URL=https://<რესურსი>.openai.azure.com/openai/deployments/<დეპლოიმენტი>
#   LLM_API_KEY_HEADER=api-key
#   LLM_QUERY_PARAMS=api-version=2024-10-21

# არასავალდებულო
# LLM_API_KEY_HEADER=Authorization      (ნაგულისხმევი: Authorization: Bearer ...)
# LLM_QUERY_PARAMS=
# RAG_MAX_CHARS=18000                   კონტექსტის მაქსიმალური სიგრძე (სიმბოლო)
# RATE_LIMIT_PER_10MIN=30               მოთხოვნების ლიმიტი IP-ზე
# QUERY_REWRITE=1                       0 — გამორთავს LLM-ით საძიებო სიტყვების გაფართოებას

# ===== ჰოსტინგზე (Vercel და მსგავსი) =====
# ლოკალური Ollama ჰოსტინგზე არ იმუშავებს, ამიტომ გამოიყენეთ უფასო ღრუბლოვანი API.
# გასაღები ჩაწერეთ ჰოსტინგის Environment Variables-ში (არა კოდში და არა GitHub-ზე).
#
# სარეზერვო პროვაიდერი: თუ ძირითადის უფასო ლიმიტი ამოიწურება, ავტომატურად ამას გამოიყენებს.
# მაგალითად Groq (უფასო ტარიფი): https://console.groq.com/keys
# LLM2_BASE_URL=https://api.groq.com/openai/v1
# LLM2_API_KEY=
# LLM2_MODEL=llama-3.1-8b-instant
#
# DAILY_LIMIT=400          დღიური საერთო მოთხოვნების ლიმიტი (0 — გამორთვა)
# RATE_LIMIT_PER_10MIN=30  ლიმიტი ერთ IP-ზე
